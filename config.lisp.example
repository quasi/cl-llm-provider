;;;; cl-llm-provider configuration file
;;;;
;;;; Copy this file to ~/.config/cl-llm-provider/config.lisp
;;;; and fill in your API keys.
;;;;
;;;; Then load it with: (cl-llm-provider:load-configuration)

;;; Provider API Keys
;;; -----------------

;; Anthropic (Claude models)
;; Get your key from: https://console.anthropic.com/
(setf (uiop:getenv "ANTHROPIC_API_KEY") "sk-ant-your-key-here")

;; OpenAI (GPT models)
;; Get your key from: https://platform.openai.com/api-keys
(setf (uiop:getenv "OPENAI_API_KEY") "sk-your-key-here")

;; OpenRouter (multi-provider gateway)
;; Get your key from: https://openrouter.ai/keys
(setf (uiop:getenv "OPENROUTER_API_KEY") "sk-or-your-key-here")

;; Ollama (local models)
;; Custom Ollama endpoint if not using default localhost:11434
;; (setf (uiop:getenv "OLLAMA_BASE_URL") "http://localhost:11434")


;;; OpenAI-Compatible Providers
;;; ----------------------------

;; Groq
;; Get your key from: https://console.groq.com/keys
;; (setf (uiop:getenv "GROQ_API_KEY") "gsk-your-key-here")

;; Together AI
;; Get your key from: https://api.together.xyz/settings/api-keys
;; (setf (uiop:getenv "TOGETHER_API_KEY") "your-key-here")


;;; Default Configuration (Optional)
;;; ---------------------------------

;; You can also set defaults directly (instead of using environment variables)

;; Default provider
;; (setf cl-llm-provider:*default-provider*
